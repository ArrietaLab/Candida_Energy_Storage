# Filter diet for differential abundance
ps_clean_filt_HFHS <- ps_clean %>%
  subset_samples(diet == "HFHS")

# Convert the phyloseq object to the DESeq2 format.
ps_clean_deseq = phyloseq_to_deseq2(ps_clean_filt_HFHS, ~ colonization) # convert to DESeq2 format and set the independent variable as SampleType

# Make B the baseline for differential abundance
ps_clean_deseq$colonization <- relevel(ps_clean_deseq$colonization, ref = "B")

# This dataset contains several zeros so we need to use a zero-tolerant variant of geometric mean.
gm_mean = function(x, na.rm=TRUE){
  exp(sum(log(x[x > 0]), na.rm=na.rm) / length(x))
}
geoMeans = apply(counts(ps_clean_deseq), 1, gm_mean)

# Estimation of size factors and dispersion and fits the model.
ps_clean_deseq = estimateSizeFactors(ps_clean_deseq, geoMeans = geoMeans)
ps_clean_deseq = DESeq(ps_clean_deseq, test="Wald", fitType="parametric") 

# Results from the test above. 
res = results(ps_clean_deseq, cooksCutoff = FALSE) # extract results without applying Cook's cut off (distance threshold) 
alpha = 0.05 # set significance threshold
sigtab = res[which(res$padj < alpha), ] # filter for significant results with the adjusted p-values smaller than 0.05
sigtab = cbind(as(sigtab, "data.frame"), as(tax_table(ps_clean)[rownames(sigtab), ], "matrix")) # combine significant results with the phyloseq taxonomy table
head(sigtab %>% dplyr::select(log2FoldChange, padj, Species)) # view Log2FoldChange, adjusted p-value and genus for significant results

# Plot the results
x = tapply(sigtab$log2FoldChange, sigtab$Species, function(x) max(x))
x = sort(x, TRUE) # sort from highest to lowest
sigtab$Species = factor(as.character(sigtab$Species), levels=names(x)) # convert Genus to factor with the levels specified as x to organize the plot

jpeg(file = "/Users/mackenziegutierrez/Desktop/Diff_abund_SD.jpeg", width = 1600, height = 1550, units = "px", res = 300)   
