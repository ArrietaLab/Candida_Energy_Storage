  ) +
  scale_color_manual(
    name = "Colonization",
    values = c("B" = "#686868", "B+C" = "#0f3bff")
  ) +
  labs(x = NULL, y = "Bile acid abundance") +
  theme_bw() +
  theme(
    legend.position = "none",
    axis.title = element_text(face = "bold", size = 10.5, color = "black"),
    axis.text = element_text(size = 9.5, color = "black"),
    strip.background = element_blank(),
    strip.text = element_text(face = "bold", size = 10.5, color = "black"),
    plot.title = element_text(colour = "black", size = 12, face = "bold", hjust = 0.5)
  )
p_top

# Plot bottom row
p_bottom <- ggplot(sig_grouped_long, aes(x = Tx, y = Value, fill = Tx)) +
